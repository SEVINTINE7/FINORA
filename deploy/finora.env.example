# Template for /etc/finora/finora.env (T56.3). server-setup.sh writes the real file with random values.
# Real file: owner finora, mode 400. Never commit a filled-in copy.
DB_URL=jdbc:mysql://127.0.0.1:3306/finora?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=finora_app
DB_PASS=change-me
SPRING_FLYWAY_USER=finora_migrate
SPRING_FLYWAY_PASSWORD=change-me
# At least 32 characters (HMAC-SHA256); server-setup.sh uses 64 hex chars
JWT_SECRET=change-me
FINORA_LLM_ENABLED=false
GROQ_API_KEY=
GEMINI_API_KEY=
# T34 push alerts: path to the Firebase service-account JSON (owner finora, mode 400). Empty = alerts recorded, not pushed.
FIREBASE_CREDENTIALS=
# D64 password reset. Enable only with the operator-approved SMTP account.
FINORA_MAIL_HOST=
FINORA_MAIL_PORT=587
FINORA_MAIL_USERNAME=
FINORA_MAIL_PASSWORD=
FINORA_MAIL_FROM=
