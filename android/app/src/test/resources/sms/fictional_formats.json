      "markers": {"prefix": "FICTION QA | ", "debit": "D", "credit": "C"},
      "fields": [
        {"name": "DIRECTION", "delimiter": " | "},
        {"name": "CURRENCY", "delimiter": " | "},
        {"name": "AMOUNT", "delimiter": " | "},
        {"name": "DATE", "delimiter": " | "},
        {"name": "MERCHANT", "delimiter": " | END"}
      ]
    }
  ]
}
