<?xml version="1.0" encoding="utf-8"?>
<!-- T63.2/D65 Add/Edit budget: month, category chips with icons, large limit, Save pinned at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/form_title"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/finora_heading_tag"
                android:text="@string/budget_add" />

            <TextView
                android:id="@+id/budget_month"
                style="@style/FinoraText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/finora_pill"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                app:drawableStartCompat="@drawable/finora_ic_calendar"
                app:drawableTint="@color/finora_muted" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/form_kind"
                android:text="@string/budget_category" />
            <lk.finora.app.ui.FormChoices
                android:id="@id/form_kind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:saveEnabled="false" />
            <TextView
                android:id="@+id/budget_category_hint"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/budget_category_hint"
                android:textColor="@color/finora_muted"
                android:visibility="gone" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/budget_limit"
                android:text="@string/budget_limit" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:hintEnabled="false"
                app:expandedHintEnabled="false"
                app:placeholderText="@string/form_amount_placeholder"
                app:prefixText="@string/form_rupees_prefix"
                app:prefixTextAppearance="@style/Finora.AmountPrefix">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/budget_limit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="64dp"
                    android:saveEnabled="false"
                    android:textColor="@color/finora_ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/budget_near_hint"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/finora_muted" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/records_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/budget_save"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_tick"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
