<?xml version="1.0" encoding="utf-8"?>
<!-- T68.2/D72 Settings: profile card, Profile (edit profile, change password), Language toggle, Alerts switches,
     Privacy and data rows. View IDs used by tests are kept. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/settings_heading"
            style="@style/FinoraText.Greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_title" />

        <include
            android:id="@+id/settings_profile_card"
            layout="@layout/view_profile_card" />

        <TextView
            android:id="@+id/settings_profile_heading"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/settings_profile" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include
                    android:id="@+id/settings_edit_profile"
                    layout="@layout/item_import_link" />
                <View style="@style/Finora.RowLine" />
                <include
                    android:id="@+id/settings_change_password"
                    layout="@layout/item_import_link" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/settings_language_heading"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/settings_language" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/settings_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_language_en"
                        style="@style/Widget.Finora.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language_english" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_language_si"
                        style="@style/Widget.Finora.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language_sinhala" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView
                    android:id="@+id/settings_language_status"
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/settings_language_info"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- T34.5 alerts: per-type switches saved via PUT /api/v1/me/alerts -->
        <TextView
            android:id="@+id/settings_alerts_heading"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/settings_alerts" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">
                <TextView
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_alerts_info"
                    android:textColor="@color/finora_muted" />

                <LinearLayout
                    android:id="@+id/settings_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/finora_pill"
                    android:backgroundTint="@color/finora_warn_fill"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/settings_notifications_status"
                        style="@style/FinoraText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:drawablePadding="10dp"
                        android:text="@string/settings_notifications_off"
                        android:textColor="@color/finora_warn_ink"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/finora_ic_alert"
                        app:drawableTint="@color/finora_warn_ink" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_notifications_allow"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="@dimen/finora_touch"
                        android:text="@string/settings_notifications_allow"
                        android:textColor="@color/finora_warn_ink"
                        android:visibility="gone"
                        app:strokeColor="@color/finora_warn_ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/finora_circle"
                        android:backgroundTint="@color/finora_success_surface"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/finora_ic_wallet"
                        app:tint="@color/finora_green" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_alert_budget"
                        style="@style/FinoraText.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:minHeight="@dimen/finora_touch"
                        android:text="@string/settings_alert_budget" />
                </LinearLayout>
                <View style="@style/Finora.RowLine" android:layout_marginStart="52dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/finora_circle"
                        android:backgroundTint="@color/finora_success_surface"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/finora_ic_bill"
                        app:tint="@color/finora_green" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_alert_bill"
                        style="@style/FinoraText.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:minHeight="@dimen/finora_touch"
                        android:text="@string/settings_alert_bill" />
                </LinearLayout>
                <View style="@style/Finora.RowLine" android:layout_marginStart="52dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/finora_circle"
                        android:backgroundTint="@color/finora_success_surface"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/finora_ic_target"
                        app:tint="@color/finora_green" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_alert_goal"
                        style="@style/FinoraText.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:minHeight="@dimen/finora_touch"
                        android:text="@string/settings_alert_goal" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/settings_privacy_heading"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/settings_privacy" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include
                    android:id="@+id/settings_export"
                    layout="@layout/item_import_link" />
                <View style="@style/Finora.RowLine" />
                <include
                    android:id="@+id/settings_withdraw"
                    layout="@layout/item_import_link" />
                <View style="@style/Finora.RowLine" />
                <include
                    android:id="@+id/settings_delete"
                    layout="@layout/item_import_link" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/records_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite" />

        <TextView
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/settings_privacy_note"
            android:textColor="@color/finora_muted" />
    </LinearLayout>
</ScrollView>
