<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/finora_outer_margin">

        <TextView
            android:id="@+id/settings_heading"
            style="@style/FinoraText.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/settings_title" />

        <TextView
            android:id="@+id/settings_language_heading"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/settings_language" />

        <FrameLayout
            android:id="@+id/settings_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_l" />

        <TextView
            android:id="@+id/settings_privacy_heading"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/settings_privacy" />

        <TextView
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/settings_withdraw_info" />

        <Button
            android:id="@+id/settings_withdraw"
            style="@style/FinoraButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/settings_withdraw" />

        <TextView
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/settings_delete_info" />

        <Button
            android:id="@+id/settings_delete"
            style="@style/FinoraButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/settings_delete" />

        <TextView
            android:id="@+id/records_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
