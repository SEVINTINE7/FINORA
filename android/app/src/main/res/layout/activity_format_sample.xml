<?xml version="1.0" encoding="utf-8"?>
<!-- T70.3/D72 Test a format (ADMIN): on-phone check of a candidate NSB format against a made-up SMS. Save appears
     only when editing a draft revision. Nothing typed here is sent, except the definition when saving a draft. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/format_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="noExcludeDescendants"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/format_heading"
            style="@style/FinoraText.Greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/staff_format_title" />

        <TextView
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/finora_pill"
            android:drawablePadding="10dp"
            android:padding="12dp"
            android:text="@string/staff_format_note"
            android:textColor="@color/finora_ink"
            app:drawableStartCompat="@drawable/finora_ic_lock"
            app:drawableTint="@color/finora_green" />

        <TextView
            android:id="@+id/format_definition_label"
            android:importantForAccessibility="no"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/sms_format_candidate" />
        <EditText
            android:id="@+id/format_definition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/finora_field"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="@string/sms_format_candidate"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="10"
            android:minLines="4"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/finora_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/format_sample_label"
            android:importantForAccessibility="no"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/sms_format_synthetic_sample" />
        <EditText
            android:id="@+id/format_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/finora_field"
            android:gravity="top|start"
            android:hint="@string/sms_format_synthetic_sample"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="6"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="@color/finora_ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/format_check"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/finora_touch"
                android:text="@string/sms_format_sample_check"
                app:icon="@drawable/finora_ic_scan" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/format_save"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="@dimen/finora_touch"
                android:text="@string/records_save"
                android:visibility="gone"
                app:icon="@drawable/finora_ic_check" />
        </LinearLayout>

        <TextView
            android:id="@+id/format_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/format_result"
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/format_result_title"
                    style="@style/FinoraText.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_format_result" />
                <TextView
                    android:id="@+id/format_result_approval"
                    style="@style/FinoraText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical" />
                <TextView
                    android:id="@+id/format_result_parsed"
                    style="@style/FinoraText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
