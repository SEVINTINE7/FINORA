<?xml version="1.0" encoding="utf-8"?>
<!-- T64.3 category cut row: expense category, monthly reduction, remove. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/cut_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/finora_card_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/finora_field_box">
                <Spinner
                    android:id="@+id/cut_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/planning_category"
                    android:minHeight="48dp"
                    android:saveEnabled="false" />
            </FrameLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:placeholderText="@string/form_amount_placeholder"
                app:prefixText="@string/form_rupees_prefix">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cut_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/planning_reduction"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/cut_remove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/planning_remove_cut"
            android:src="@drawable/finora_ic_close"
            app:tint="@color/finora_muted" />
    </LinearLayout>
</LinearLayout>
