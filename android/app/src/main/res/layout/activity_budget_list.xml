<?xml version="1.0" encoding="utf-8"?>
<!-- T63.2/D65 Budgets: month pill, left-to-spend summary, progress cards (most urgent first), Add budget FAB. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/budget_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="@dimen/finora_fab_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/budget_title"
                    style="@style/FinoraText.Greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="@string/finora_heading_tag"
                    android:text="@string/budget_list_title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/finora_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <ImageButton
                        android:id="@+id/budget_previous"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/budget_previous_month"
                        android:src="@drawable/finora_ic_chevron_left"
                        android:tooltipText="@string/budget_previous_month"
                        app:tint="@color/finora_ink" />

                    <TextView
                        android:id="@+id/budget_month"
                        style="@style/FinoraText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite" />

                    <ImageButton
                        android:id="@+id/budget_next"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/budget_next_month"
                        android:src="@drawable/finora_ic_chevron_right"
                        android:tooltipText="@string/budget_next_month"
                        app:tint="@color/finora_ink" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budget_summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/finora_hero"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/budget_summary_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/finora_hero_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/budget_summary_amount"
                        style="@style/FinoraText.Hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autoSizeMaxTextSize="32sp"
                        android:autoSizeMinTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/budget_summary_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        app:indicatorColor="@color/finora_mint"
                        app:trackColor="@color/finora_hero_tile"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/budget_summary_used"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/finora_hero_ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/records_status"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/records_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/records_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/records_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/records_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/budget_add"
        app:icon="@drawable/finora_ic_add" />
</FrameLayout>
