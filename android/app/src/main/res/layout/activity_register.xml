<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/finora_outer_margin">

        <TextView
            android:id="@+id/register_heading"
            style="@style/FinoraText.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/register_title" />

        <EditText
            android:id="@+id/register_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:autofillHints="emailAddress"
            android:hint="@string/register_email"
            android:inputType="textEmailAddress"
            android:minHeight="@dimen/finora_touch" />

        <EditText
            android:id="@+id/register_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:autofillHints="name"
            android:hint="@string/register_name"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="@dimen/finora_touch" />

        <EditText
            android:id="@+id/register_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="newPassword"
            android:hint="@string/register_password"
            android:inputType="textPassword"
            android:minHeight="@dimen/finora_touch" />

        <TextView
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/register_password_rule" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/register_language"
            android:text="@string/register_language" />

        <Spinner
            android:id="@+id/register_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:minHeight="@dimen/finora_touch" />

        <TextView
            android:id="@+id/register_consent_heading"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/register_consent_heading" />

        <TextView
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/register_consent_text" />

        <CheckBox
            android:id="@+id/register_over18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/finora_touch"
            android:text="@string/register_over18" />

        <CheckBox
            android:id="@+id/register_consent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:minHeight="@dimen/finora_touch"
            android:text="@string/register_consent" />

        <Button
            android:id="@+id/register_submit"
            style="@style/FinoraButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/register_submit" />

        <include android:id="@+id/register_feedback" layout="@layout/view_state" />

        <Button
            android:id="@+id/register_back"
            style="@style/FinoraButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/finora_space_s"
            android:text="@string/register_have_account" />
    </LinearLayout>
</ScrollView>
