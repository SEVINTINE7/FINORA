<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <ProgressBar android:id="@+id/state_progress" android:layout_width="24dp"
        android:layout_height="24dp" android:layout_marginEnd="12dp"
        android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:id="@+id/state_message" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />
</LinearLayout>
