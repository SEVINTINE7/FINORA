<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/finora_space_s"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/finora_space_s"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/state_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="@dimen/finora_icon"
        android:layout_height="@dimen/finora_icon"
        android:layout_marginEnd="@dimen/finora_space_s"
        android:importantForAccessibility="no"
        android:indeterminateTint="@color/finora_green"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/state_icon"
        android:layout_width="@dimen/finora_icon"
        android:layout_height="@dimen/finora_icon"
        android:layout_marginEnd="@dimen/finora_space_s"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/state_message"
        style="@style/FinoraText.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
