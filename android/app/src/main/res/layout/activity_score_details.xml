<?xml version="1.0" encoding="utf-8"?>
<!-- T66.2/D70 Score details: large Rs. reserve, calendar date, Not sure/Yes/No tiles, Save pinned at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/score_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/score_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/finora_heading_tag"
                android:text="@string/score_details_title" />

            <TextView
                android:id="@+id/score_intro"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/finora_muted" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/score_reserve"
                android:text="@string/score_reserve" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/score_reserve_box"
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:expandedHintEnabled="false"
                app:hintEnabled="false"
                app:placeholderText="@string/form_amount_placeholder"
                app:prefixText="@string/form_rupees_prefix"
                app:prefixTextAppearance="@style/Finora.AmountPrefix">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/score_reserve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="64dp"
                    android:saveEnabled="false"
                    android:textColor="@color/finora_ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/score_reserve_help"
                android:textColor="@color/finora_muted" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/score_date"
                android:text="@string/score_reserve_date" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@id/score_date"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textColor="@color/finora_ink"
                    app:cornerRadius="@dimen/finora_group_radius"
                    app:icon="@drawable/finora_ic_calendar"
                    app:iconPadding="12dp"
                    app:iconTint="@color/finora_muted"
                    app:strokeColor="@color/finora_outline" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/score_date_clear"
                    style="@style/Widget.Finora.TextAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/score_reserve_clear"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/score_date_help"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/finora_muted" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/score_debt"
                android:text="@string/score_debt_question" />
            <lk.finora.app.ui.FormChoices
                android:id="@id/score_debt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/finora_touch"
                android:saveEnabled="false" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/score_goals"
                android:text="@string/score_goals_question" />
            <lk.finora.app.ui.FormChoices
                android:id="@id/score_goals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/finora_touch"
                android:saveEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/score_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/score_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/score_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/score_save"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_tick"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
