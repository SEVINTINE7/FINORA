<?xml version="1.0" encoding="utf-8"?>
<!-- T67/D71 one imported transaction: optional tick, direction icon, title, date line, signed Rs. amount,
     and an optional note (CSV problem or "Already imported"). Read as one item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/import_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/import_check"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/import_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/finora_circle"
        android:importantForAccessibility="no"
        android:padding="9dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/import_title"
            style="@style/FinoraText.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/import_meta"
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/finora_muted" />
        <TextView
            android:id="@+id/import_note"
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/import_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/finora_ink"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
