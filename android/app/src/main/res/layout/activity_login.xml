<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/login_brand_art"
                android:layout_width="@dimen/finora_art_size"
                android:layout_height="@dimen/finora_art_size"
                android:layout_gravity="end|bottom"
                android:importantForAccessibility="no"
                android:alpha="0.26"
                android:src="@drawable/finora_orbit" />

            <LinearLayout
                android:id="@+id/login_brand_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/finora_outer_margin"
                android:paddingTop="@dimen/finora_space_m"
                android:paddingEnd="@dimen/finora_outer_margin"
                android:paddingBottom="@dimen/finora_space_xl">

                <TextView
                    style="@style/FinoraText.Wordmark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:drawableStartCompat="@drawable/finora_mark"
                    android:drawablePadding="@dimen/finora_space_xs"
                    android:gravity="center_vertical"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/login_brand_headline"
                    style="@style/FinoraText.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/finora_space_m"
                    android:text="@string/login_brand_headline" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/login_sheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/finora_sheet"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_outer_margin"
            android:paddingTop="@dimen/finora_space_xl"
            android:paddingEnd="@dimen/finora_outer_margin"
            android:paddingBottom="@dimen/finora_space_xl">

            <TextView
                android:id="@+id/login_heading"
                style="@style/FinoraText.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_heading" />

            <TextView
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:text="@string/login_support" />

            <TextView
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_l"
                android:labelFor="@+id/email"
                android:text="@string/email" />

            <LinearLayout
                android:id="@+id/email_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:background="@drawable/finora_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/finora_icon"
                    android:layout_height="@dimen/finora_icon"
                    android:layout_marginStart="@dimen/finora_space_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_mail" />

                <EditText
                    android:id="@id/email"
                    style="@style/FinoraInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="username"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:nextFocusForward="@+id/password" />
            </LinearLayout>

            <TextView
                android:id="@+id/email_error"
                style="@style/FinoraText.FieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <TextView
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_m"
                android:labelFor="@id/password"
                android:text="@string/password" />

            <LinearLayout
                android:id="@+id/password_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:background="@drawable/finora_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/finora_icon"
                    android:layout_height="@dimen/finora_icon"
                    android:layout_marginStart="@dimen/finora_space_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_lock" />

                <EditText
                    android:id="@id/password"
                    style="@style/FinoraInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:imeOptions="actionDone|flagNoPersonalizedLearning"
                    android:inputType="textPassword"
                    android:saveEnabled="false" />

                <ImageButton
                    android:id="@+id/password_visibility"
                    style="@style/FinoraButton.Secondary"
                    android:layout_width="@dimen/finora_touch"
                    android:layout_height="@dimen/finora_touch"
                    android:minHeight="@dimen/finora_touch"
                    android:padding="0dp"
                    app:tint="@color/finora_secondary_text"
                    android:contentDescription="@string/login_show_password"
                    android:src="@drawable/finora_ic_eye" />
            </LinearLayout>

            <TextView
                android:id="@+id/password_error"
                style="@style/FinoraText.FieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <Button
                android:id="@+id/sign_in"
                style="@style/FinoraButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_l"
                android:text="@string/sign_in" />

            <include android:id="@+id/login_feedback" layout="@layout/view_state" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
