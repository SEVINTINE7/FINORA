<?xml version="1.0" encoding="utf-8"?>
<!-- T64.3/D65/D68 Planning: one screen, two modes. Daily spending guide: result card, Rs. inputs with help,
     next income date from the calendar, tracked-bills card. Goal simulation: goal, monthly savings, More/Less
     change, category cuts, estimate card. Calculate pinned at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/planning_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/planning_title"
                    style="@style/FinoraText.Greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="@string/finora_heading_tag" />

                <ImageButton
                    android:id="@+id/planning_info"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/planning_assumptions"
                    android:src="@drawable/finora_ic_info"
                    app:tint="@color/finora_ink" />
            </LinearLayout>

            <!-- Result: the daily allowance or the simulation estimate. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/planning_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/finora_hero"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/planning_result_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/finora_hero_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/planning_result_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="0dp">

                        <TextView
                            android:id="@+id/planning_result_amount"
                            style="@style/FinoraText.Hero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/planning_result_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:paddingTop="16dp"
                            android:textColor="@color/finora_hero_ink"
                            android:textSize="15sp" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/planning_result_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/finora_hero_ink"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/planning_result_rule"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/finora_hero_tile" />

                    <LinearLayout
                        android:id="@+id/planning_result_lines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/planning_result_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/finora_hero_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- A status that is not a result (missing input, income today, over-committed...). -->
            <TextView
                android:id="@+id/planning_message"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/finora_badge"
                android:backgroundTint="@color/finora_warn_fill"
                android:drawablePadding="10dp"
                android:padding="12dp"
                android:textColor="@color/finora_warn_ink"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/finora_ic_alert"
                app:drawableTint="@color/finora_warn_ink" />

            <!-- Daily spending guide inputs. -->
            <LinearLayout
                android:id="@+id/planning_guide_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/planning_inputs_heading"
                    style="@style/FinoraText.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/planning_inputs"
                    android:textSize="16sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:helperText="@string/planning_funds_help"
                    app:placeholderText="@string/form_amount_placeholder"
                    app:prefixText="@string/form_rupees_prefix">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/planning_funds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/planning_funds"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:minHeight="@dimen/finora_touch"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:helperText="@string/planning_savings_help"
                    app:placeholderText="@string/form_amount_placeholder"
                    app:prefixText="@string/form_rupees_prefix">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/planning_savings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/planning_savings"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:minHeight="@dimen/finora_touch"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:helperText="@string/planning_arrears_help"
                    app:placeholderText="@string/form_amount_placeholder"
                    app:prefixText="@string/form_rupees_prefix">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/planning_arrears"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/planning_arrears"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:minHeight="@dimen/finora_touch"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Finora.FormLabel"
                    android:layout_marginTop="8dp"
                    android:labelFor="@+id/planning_income_date"
                    android:text="@string/planning_income_date" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@id/planning_income_date"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:minHeight="56dp"
                        android:saveEnabled="false"
                        android:textColor="@color/finora_ink"
                        app:cornerRadius="@dimen/finora_group_radius"
                        app:icon="@drawable/finora_ic_calendar"
                        app:iconPadding="12dp"
                        app:iconTint="@color/finora_muted"
                        app:strokeColor="@color/finora_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/planning_income_clear"
                        style="@style/Widget.Finora.TextAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/planning_income_clear"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/planning_income_help"
                    android:textColor="@color/finora_muted" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/planning_bills_card"
                    style="@style/Widget.Finora.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/planning_bills_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/planning_bills_icon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/finora_circle"
                                android:importantForAccessibility="no"
                                android:padding="8dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:importantForAccessibility="noHideDescendants"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/planning_bills_title"
                                    style="@style/FinoraText.RowTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/planning_bills_detail"
                                    style="@style/FinoraText.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/finora_muted" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/planning_confirm"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:text="@string/planning_confirm_bills"
                            android:textColor="@color/finora_ink"
                            android:visibility="gone"
                            app:backgroundTint="@color/finora_warn_fill" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Goal simulation inputs. -->
            <LinearLayout
                android:id="@+id/planning_simulation_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/planning_goal"
                    android:text="@string/planning_goal" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/finora_field_box">
                    <Spinner
                        android:id="@id/planning_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/planning_goal"
                        android:minHeight="56dp"
                        android:saveEnabled="false" />
                </FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:placeholderText="@string/form_amount_placeholder"
                    app:prefixText="@string/form_rupees_prefix">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/planning_baseline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/planning_baseline"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:minHeight="@dimen/finora_touch"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/planning_change_label"
                    style="@style/Finora.FormLabel"
                    android:text="@string/planning_change" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/planning_direction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        app:checkedButton="@+id/planning_more"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@id/planning_more"
                            style="@style/Widget.Finora.Segment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/planning_more_spoken"
                            android:text="@string/planning_more" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/planning_less"
                            style="@style/Widget.Finora.Segment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/planning_less_spoken"
                            android:text="@string/planning_less" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FinoraField.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:placeholderText="@string/form_amount_placeholder"
                        app:prefixText="@string/form_rupees_prefix">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/planning_adjustment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/planning_adjustment"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:minHeight="@dimen/finora_touch"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    style="@style/Finora.FormLabel"
                    android:text="@string/planning_cuts" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Finora.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/planning_cuts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/planning_add_cut"
                            style="@style/Widget.Finora.TextAction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:text="@string/planning_add_cut"
                            app:icon="@drawable/finora_ic_add"
                            app:iconGravity="textStart"
                            app:iconTint="@color/finora_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/planning_cuts_help"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/planning_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/planning_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/planning_calculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/planning_calculate"
            android:textSize="16sp"
            app:cornerRadius="28dp" />
    </LinearLayout>
</LinearLayout>
