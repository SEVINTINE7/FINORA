<?xml version="1.0" encoding="utf-8"?>
<!-- T62.3/D65 Home. Sections are filled by DashboardPanel; every chart is followed by exact text values. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/finora_fab_clearance">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/finora_screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dashboard_greeting"
                    style="@style/FinoraText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/dashboard_name"
                    style="@style/FinoraText.Greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="@string/finora_heading_tag"
                    android:text="@string/home_tab" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/finora_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageButton
                    android:id="@+id/dashboard_previous"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dashboard_previous"
                    android:src="@drawable/finora_ic_chevron_left"
                    android:tooltipText="@string/dashboard_previous"
                    app:tint="@color/finora_ink" />

                <TextView
                    android:id="@+id/dashboard_month"
                    style="@style/FinoraText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite" />

                <ImageButton
                    android:id="@+id/dashboard_next"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dashboard_next"
                    android:src="@drawable/finora_ic_chevron_right"
                    android:tooltipText="@string/dashboard_next"
                    app:tint="@color/finora_ink" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dashboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_balance_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/finora_hero"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/dashboard_net_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_net_this_month"
                    android:textColor="@color/finora_hero_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/dashboard_net_amount"
                    style="@style/FinoraText.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="32sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/dashboard_income_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/finora_badge"
                        android:backgroundTint="@color/finora_hero_tile"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/finora_circle"
                            android:backgroundTint="@color/finora_mint"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/finora_ic_arrow_up"
                            app:tint="@color/finora_navy" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="NestedWeights">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/category_income"
                                android:textColor="@color/finora_hero_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/dashboard_income_amount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autoSizeMaxTextSize="15sp"
                                android:autoSizeMinTextSize="10sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:textColor="@color/finora_hero_ink"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dashboard_expense_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/finora_badge"
                        android:backgroundTint="@color/finora_hero_tile"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/finora_circle"
                            android:backgroundTint="#FCEDEA"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/finora_ic_arrow_down"
                            app:tint="#982C30" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="NestedWeights">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/category_expense"
                                android:textColor="@color/finora_hero_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/dashboard_expense_amount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autoSizeMaxTextSize="15sp"
                                android:autoSizeMinTextSize="10sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:textColor="@color/finora_hero_ink"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/dashboard_empty"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dashboard_empty"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/dashboard_score_ring_frame"
                    android:layout_width="76dp"
                    android:layout_height="76dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/dashboard_score_ring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:indicatorColor="@color/finora_green"
                        app:indicatorSize="76dp"
                        app:trackColor="@color/finora_card_line"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="7dp" />

                    <TextView
                        android:id="@+id/dashboard_score_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/finora_ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FinoraText.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="@string/finora_heading_tag"
                        android:text="@string/score_heading" />

                    <TextView
                        android:id="@+id/dashboard_score_text"
                        style="@style/FinoraText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/records_loading" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_advice"
                        style="@style/Widget.Finora.TextAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-8dp"
                        android:text="@string/dashboard_see_advice"
                        app:icon="@drawable/finora_ic_chevron_right"
                        app:iconGravity="end"
                        app:iconSize="16dp"
                        app:iconTint="@color/finora_green" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout style="@style/Finora.SectionHeader">
            <TextView
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="@string/finora_heading_tag"
                android:text="@string/dashboard_recent_transactions" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashboard_recent_all"
                style="@style/Widget.Finora.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_see_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashboard_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout style="@style/Finora.SectionHeader">
            <TextView
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="@string/finora_heading_tag"
                android:text="@string/budget_list_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashboard_budgets_manage"
                style="@style/Widget.Finora.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_manage" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/dashboard_budgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout style="@style/Finora.SectionHeader">
            <TextView
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="@string/finora_heading_tag"
                android:text="@string/dashboard_upcoming_bills" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashboard_bills_all"
                style="@style/Widget.Finora.TextAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_see_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashboard_bills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout style="@style/Finora.SectionHeader">
            <TextView
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="@string/finora_heading_tag"
                android:text="@string/dashboard_focus_goal" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/finora_success_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/dashboard_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout style="@style/Finora.SectionHeader">
            <TextView
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="@string/finora_heading_tag"
                android:text="@string/dashboard_categories" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/dashboard_category_chart"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/dashboard_category_legend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout style="@style/Finora.SectionHeader">
            <TextView
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="@string/finora_heading_tag"
                android:text="@string/dashboard_trend" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/dashboard_trend_chart"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/dashboard_trend_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
