<?xml version="1.0" encoding="utf-8"?>
<!-- T65.3/D65/D69 Add/Edit category: Expense/Income tiles (locked when editing), English and Sinhala names,
     Need/Want/Not set tiles, live preview with the icon chosen from the name, Save pinned at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/category_form_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/finora_heading_tag"
                android:text="@string/category_add" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/form_kind"
                android:text="@string/category_kind" />
            <lk.finora.app.ui.FormChoices
                android:id="@id/form_kind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/finora_touch"
                android:saveEnabled="false" />
            <TextView
                android:id="@+id/category_type_note"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/category_type_note"
                android:textColor="@color/finora_muted" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/form_name"
                android:text="@string/category_name_en" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/form_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/category_name_si"
                android:text="@string/category_name_si" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/category_name_si_help"
                app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/category_name_si"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/category_classification"
                android:text="@string/category_need_or_want" />
            <lk.finora.app.ui.FormChoices
                android:id="@id/category_classification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/finora_touch"
                android:saveEnabled="false" />
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/category_need_help"
                android:textColor="@color/finora_muted" />

            <TextView
                style="@style/Finora.FormLabel"
                android:text="@string/category_preview" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/finora_group_radius">
                <LinearLayout
                    android:id="@+id/category_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">
                    <ImageView
                        android:id="@+id/category_preview_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/finora_circle"
                        android:importantForAccessibility="no"
                        android:padding="8dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/category_preview_name"
                            style="@style/FinoraText.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/category_preview_kind"
                            style="@style/FinoraText.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/finora_muted" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/category_preview_need"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/finora_badge"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:minHeight="24dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/category_icon_help"
                android:textColor="@color/finora_muted" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/records_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/category_save"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_tick"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
