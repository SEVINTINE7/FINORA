<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/finora_outer_margin">

        <TextView
            style="@style/FinoraText.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/category_form_title" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/FinoraField.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/form_name"
                android:minHeight="@dimen/finora_control_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/records_name"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/FinoraField.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/category_name_si"
                android:minHeight="@dimen/finora_control_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/category_name_si"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/category_kind"
            android:labelFor="@id/form_kind" />

        <lk.finora.app.ui.FormChoices
            android:id="@+id/form_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:minHeight="@dimen/finora_touch"
            android:saveEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/category_classification"
            android:labelFor="@id/category_classification" />

        <lk.finora.app.ui.FormChoices
            android:id="@+id/category_classification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:minHeight="@dimen/finora_touch"
            android:saveEnabled="false" />

        <TextView
            android:id="@+id/records_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/records_save"
            style="@style/FinoraButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/records_save" />

        <Button
            android:id="@+id/records_retry"
            style="@style/FinoraButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/records_retry" />
    </LinearLayout>
</ScrollView>
