<?xml version="1.0" encoding="utf-8"?>
<!-- T64.2/D65/D68 Add/Edit goal: name, large target amount, No deadline / By a date toggle with a calendar date,
     monthly hint, Save pinned at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/goal_form_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/finora_heading_tag"
                android:text="@string/goal_add_goal" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/form_name"
                android:text="@string/goal_name_label" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/finora_ic_cat_savings"
                app:startIconTint="@color/finora_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/form_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/goal_target"
                android:text="@string/goal_target" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:expandedHintEnabled="false"
                app:hintEnabled="false"
                app:placeholderText="@string/form_amount_placeholder"
                app:prefixText="@string/form_rupees_prefix"
                app:prefixTextAppearance="@style/Finora.AmountPrefix">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/goal_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="64dp"
                    android:saveEnabled="false"
                    android:textColor="@color/finora_ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/goal_deadline_label"
                style="@style/Finora.FormLabel"
                android:text="@string/goal_deadline" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/goal_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/goal_deadline_none"
                    style="@style/Widget.Finora.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/goal_no_deadline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/goal_deadline_date"
                    style="@style/Widget.Finora.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/goal_deadline_date" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/goal_date_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/goal_target_date"
                    android:text="@string/goal_target_date" />
                <com.google.android.material.button.MaterialButton
                    android:id="@id/goal_target_date"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textColor="@color/finora_ink"
                    app:cornerRadius="@dimen/finora_group_radius"
                    app:icon="@drawable/finora_ic_calendar"
                    app:iconPadding="12dp"
                    app:iconTint="@color/finora_muted"
                    app:strokeColor="@color/finora_card_line" />
                <TextView
                    android:id="@+id/goal_target_date_error"
                    style="@style/Finora.FormError" />
                <TextView
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/goal_target_date_hint"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/goal_monthly_hint"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/finora_badge"
                android:backgroundTint="@color/finora_success_surface"
                android:drawablePadding="10dp"
                android:padding="12dp"
                android:textColor="@color/finora_green"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/finora_ic_trend"
                app:drawableTint="@color/finora_green" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/records_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/goal_save"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_tick"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
