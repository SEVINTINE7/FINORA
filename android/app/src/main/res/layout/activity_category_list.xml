<?xml version="1.0" encoding="utf-8"?>
<!-- T65.3/D65/D69 Categories: intro with a lock, one grouped card per type (Expense, then Income) with your own
     categories first, Add category FAB. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/category_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="@dimen/finora_fab_clearance">

            <TextView
                android:id="@+id/category_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/finora_heading_tag"
                android:text="@string/category_list_title" />

            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/category_intro"
                android:textColor="@color/finora_muted"
                app:drawableStartCompat="@drawable/finora_ic_lock"
                app:drawableTint="@color/finora_outline" />

            <TextView
                android:id="@+id/records_status"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/records_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/records_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/category_expense_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/category_expense_heading"
                    style="@style/FinoraText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/category_expense"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/category_expense_count"
                    style="@style/FinoraText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/category_expense_card"
                style="@style/Widget.Finora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/finora_group_radius">
                <LinearLayout
                    android:id="@+id/category_expense_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/category_income_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/category_income_heading"
                    style="@style/FinoraText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/category_income"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/category_income_count"
                    style="@style/FinoraText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/category_income_card"
                style="@style/Widget.Finora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/finora_group_radius">
                <LinearLayout
                    android:id="@+id/category_income_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/records_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/category_add"
        app:icon="@drawable/finora_ic_add" />
</FrameLayout>
