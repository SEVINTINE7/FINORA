<?xml version="1.0" encoding="utf-8"?>
<!-- T68.3/D72 Help: expandable FAQ card and a "Still need help?" card that opens Support requests. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/faq_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/faq_heading"
            style="@style/FinoraText.Greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/finance_help" />

        <TextView
            android:id="@+id/faq_title"
            style="@style/FinoraText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/faq_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/faq_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include android:id="@+id/faq_login" layout="@layout/item_faq" />
                <View style="@style/Finora.RowLine" android:layout_marginStart="64dp" />
                <include android:id="@+id/faq_navigation" layout="@layout/item_faq" />
                <View style="@style/Finora.RowLine" android:layout_marginStart="64dp" />
                <include android:id="@+id/faq_language" layout="@layout/item_faq" />
                <View style="@style/Finora.RowLine" android:layout_marginStart="64dp" />
                <include android:id="@+id/faq_privacy" layout="@layout/item_faq" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/finora_hero"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/faq_more_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:text="@string/faq_more_title"
                    android:textColor="@color/finora_hero_ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/finora_ic_mail"
                    app:drawableTint="@color/finora_mint" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/faq_more_text"
                    android:textColor="@color/finora_hero_ink"
                    android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/faq_open_support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="@dimen/finora_touch"
                    android:text="@string/support_tickets"
                    android:textColor="@color/finora_navy"
                    app:backgroundTint="@color/finora_mint"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
