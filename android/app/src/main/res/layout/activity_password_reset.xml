<?xml version="1.0" encoding="utf-8"?>
<!-- T69.2/D72 matches the Login style: navy brand header with back, then the surface sheet. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reset_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/reset_brand_art"
                android:layout_width="@dimen/finora_art_size"
                android:layout_height="@dimen/finora_art_size"
                android:layout_gravity="end|bottom"
                android:alpha="0.26"
                android:importantForAccessibility="no"
                android:src="@drawable/finora_orbit" />
            <LinearLayout
                android:id="@+id/reset_brand_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="@dimen/finora_space_xs"
                android:paddingEnd="@dimen/finora_outer_margin"
                android:paddingBottom="@dimen/finora_space_xl">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/reset_back_button"
                        android:layout_width="@dimen/finora_touch"
                        android:layout_height="@dimen/finora_touch"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/reset_back_sign_in"
                        android:src="@drawable/finora_nav_up"
                        app:tint="@color/finora_on_navy" />
                    <TextView
                        style="@style/FinoraText.Wordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:drawablePadding="@dimen/finora_space_xs"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:text="@string/app_name"
                        app:drawableStartCompat="@drawable/finora_mark" />
                </LinearLayout>
                <TextView
                    android:id="@+id/reset_headline"
                    style="@style/FinoraText.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="@dimen/finora_space_s"
                    android:textSize="30sp"
                    android:text="@string/reset_headline_email" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/reset_sheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/finora_sheet"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_outer_margin"
            android:paddingTop="@dimen/finora_space_xl"
            android:paddingEnd="@dimen/finora_outer_margin"
            android:paddingBottom="@dimen/finora_space_xl">
            <LinearLayout
                android:id="@+id/reset_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/finora_space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">
                    <View
                        android:id="@+id/reset_step1_bar"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:background="@drawable/finora_pill" />
                    <TextView
                        android:id="@+id/reset_step1_label"
                        style="@style/FinoraText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/reset_step_email" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    
                    android:orientation="vertical">
                    <View
                        android:id="@+id/reset_step2_bar"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:background="@drawable/finora_pill" />
                    <TextView
                        android:id="@+id/reset_step2_label"
                        style="@style/FinoraText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/reset_step_code" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/reset_heading"
                style="@style/FinoraText.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reset_title" />
            <TextView
                android:id="@+id/reset_intro"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:text="@string/reset_intro" />
            <LinearLayout
                android:id="@+id/reset_email_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_m"
                android:labelFor="@+id/reset_email"
                android:text="@string/register_email" />
            <LinearLayout
                android:id="@+id/reset_email_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:background="@drawable/finora_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/finora_icon"
                    android:layout_height="@dimen/finora_icon"
                    android:layout_marginStart="@dimen/finora_space_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_mail" />
                <EditText
                    android:id="@id/reset_email"
                    style="@style/FinoraInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionSend"
                    android:inputType="textEmailAddress" />
            </LinearLayout>
            <TextView
                android:id="@+id/reset_email_error"
                style="@style/FinoraText.FieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/reset_code_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
            <TextView
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_m"
                android:labelFor="@+id/reset_code_input"
                android:text="@string/reset_code" />
            <LinearLayout
                android:id="@+id/reset_code_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:background="@drawable/finora_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/finora_icon"
                    android:layout_height="@dimen/finora_icon"
                    android:layout_marginStart="@dimen/finora_space_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_key" />
                <EditText
                    android:id="@id/reset_code_input"
                    style="@style/FinoraInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="smsOTPCode"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:letterSpacing="0.3"
                    android:maxLength="6" />
            </LinearLayout>
            <TextView
                android:id="@+id/reset_code_error"
                style="@style/FinoraText.FieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_resend"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/finora_touch"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:text="@string/reset_resend"
                app:icon="@drawable/finora_ic_refresh"
                app:iconTint="@color/finora_green" />
            <TextView
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_m"
                android:labelFor="@+id/reset_password"
                android:text="@string/admin_new_password" />
            <LinearLayout
                android:id="@+id/reset_password_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:background="@drawable/finora_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/finora_icon"
                    android:layout_height="@dimen/finora_icon"
                    android:layout_marginStart="@dimen/finora_space_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_lock" />
                <EditText
                    android:id="@id/reset_password"
                    style="@style/FinoraInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:saveEnabled="false" />
                <ImageButton
                    android:id="@+id/reset_password_visibility"
                    style="@style/FinoraButton.Secondary"
                    android:layout_width="@dimen/finora_touch"
                    android:layout_height="@dimen/finora_touch"
                    android:minHeight="@dimen/finora_touch"
                    android:padding="0dp"
                    android:contentDescription="@string/login_show_password"
                    android:src="@drawable/finora_ic_eye"
                    app:tint="@color/finora_secondary_text" />
            </LinearLayout>
            <TextView
                android:id="@+id/reset_password_error"
                style="@style/FinoraText.FieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/reset_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <TextView
                    android:id="@+id/reset_rule_length"
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:minHeight="24dp"
                    android:text="@string/password_rule_length"
                    app:drawableStartCompat="@drawable/finora_ic_dot" />
                <TextView
                    android:id="@+id/reset_rule_letter"
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:minHeight="24dp"
                    android:text="@string/password_rule_letter"
                    app:drawableStartCompat="@drawable/finora_ic_dot" />
                <TextView
                    android:id="@+id/reset_rule_digit"
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:minHeight="24dp"
                    android:text="@string/password_rule_digit"
                    app:drawableStartCompat="@drawable/finora_ic_dot" />
            </LinearLayout>
            <TextView
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_m"
                android:labelFor="@+id/reset_repeat"
                android:text="@string/password_repeat" />
            <LinearLayout
                android:id="@+id/reset_repeat_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:background="@drawable/finora_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/finora_icon"
                    android:layout_height="@dimen/finora_icon"
                    android:layout_marginStart="@dimen/finora_space_m"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_lock" />
                <EditText
                    android:id="@id/reset_repeat"
                    style="@style/FinoraInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone|flagNoPersonalizedLearning"
                    android:inputType="textPassword"
                    android:saveEnabled="false" />
                <ImageButton
                    android:id="@+id/reset_repeat_visibility"
                    style="@style/FinoraButton.Secondary"
                    android:layout_width="@dimen/finora_touch"
                    android:layout_height="@dimen/finora_touch"
                    android:minHeight="@dimen/finora_touch"
                    android:padding="0dp"
                    android:contentDescription="@string/login_show_password"
                    android:src="@drawable/finora_ic_eye"
                    app:tint="@color/finora_secondary_text" />
            </LinearLayout>
            <TextView
                android:id="@+id/reset_repeat_error"
                style="@style/FinoraText.FieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            </LinearLayout>
            <Button
                android:id="@+id/reset_action"
                style="@style/FinoraButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_l"
                android:text="@string/reset_request" />
            <include android:id="@+id/reset_feedback" layout="@layout/view_state" />
            <Button
                android:id="@+id/reset_back"
                style="@style/FinoraButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:text="@string/reset_back_sign_in" />
            <TextView
                android:id="@+id/reset_note"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_s"
                android:background="@drawable/finora_pill"
                android:drawablePadding="10dp"
                android:padding="12dp"
                android:text="@string/reset_note"
                android:textColor="@color/finora_ink"
                app:drawableStartCompat="@drawable/finora_ic_shield"
                app:drawableTint="@color/finora_green" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
