<?xml version="1.0" encoding="utf-8"?>
<!-- T65.3/D69 category row inside a grouped card: icon, name with the other-language name under it, Need/Want
     chip, then a remove button (your own) or a lock (default). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/category_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/finora_card_line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/category_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="56dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/category_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/finora_circle"
                android:importantForAccessibility="no"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_name"
                    style="@style/FinoraText.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/record_details"
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/category_need"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/finora_badge"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:minHeight="24dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/record_remove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/records_remove"
            android:src="@drawable/finora_ic_delete"
            app:tint="@color/finora_muted" />

        <ImageView
            android:id="@+id/category_lock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:src="@drawable/finora_ic_lock"
            android:visibility="gone"
            app:tint="@color/finora_outline" />
    </FrameLayout>
</LinearLayout>
