<?xml version="1.0" encoding="utf-8"?>
<!-- T67.2/D65/D71 Paste SMS: three steps and Paste and check, then the parsed fields as Amount/Date/Type/Merchant
     rows (checked on this phone), Review, and the report link when a message could not be read. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sms_paste_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/sms_paste_title"
            style="@style/FinoraText.Greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="@string/finora_heading_tag"
            android:text="@string/sms_paste" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:id="@+id/sms_paste_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sms_paste_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="56dp"
                    android:text="@string/sms_paste_parse"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/finora_ic_clip"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/sms_paste_result"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:saveEnabled="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sms_paste_found"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <TextView
                    android:id="@+id/sms_paste_found_heading"
                    style="@style/FinoraText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sms_details_found"
                    android:textSize="16sp" />
                <TextView
                    style="@style/FinoraText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sms_details_local"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sms_paste_fields_card"
                style="@style/Widget.Finora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                app:cardCornerRadius="20dp">
                <LinearLayout
                    android:id="@+id/sms_paste_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sms_details_note"
                android:textColor="@color/finora_muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sms_paste_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="@string/sms_transaction_preview"
            android:textSize="16sp"
            android:visibility="gone"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_chevron_right"
            app:iconGravity="textEnd" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sms_diagnostic_report"
            style="@style/Widget.Finora.TextAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/sms_report_problem"
            android:visibility="gone"
            app:icon="@drawable/finora_ic_flag"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
