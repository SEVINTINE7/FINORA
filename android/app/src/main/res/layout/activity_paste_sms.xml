<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/finora_outer_margin">

        <TextView
            android:id="@+id/sms_paste_title"
            style="@style/FinoraText.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sms_paste"
            android:layout_marginBottom="@dimen/finora_space_s" />

        <TextView
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sms_paste_hint"
            android:layout_marginBottom="@dimen/finora_space_s" />

        <Button
            android:id="@+id/sms_paste_action"
            style="@style/FinoraButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sms_paste_parse"
            android:layout_marginBottom="@dimen/finora_space_s" />

        <TextView
            android:id="@+id/sms_paste_result"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:saveEnabled="false" />

        <Button
            android:id="@+id/sms_paste_preview"
            style="@style/FinoraButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sms_transaction_preview"
            android:visibility="gone" />
        <Button
            android:id="@+id/sms_diagnostic_report"
            style="@style/FinoraButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sms_report_problem"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
