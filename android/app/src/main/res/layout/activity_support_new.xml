<?xml version="1.0" encoding="utf-8"?>
<!-- T68.3/D72 New support request: four topic tiles, the exact standard sentence that will be sent, and Send
     pinned at the bottom. No confirm dialog: the screen already shows what is sent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/support_new_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_create" />

            <TextView
                android:id="@+id/support_new_question"
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/support_new_question" />

            <RadioGroup
                android:id="@+id/support_topics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/support_will_send" />
            <TextView
                android:id="@+id/support_preview"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/finora_bubble_reply"
                android:padding="14dp"
                android:text="@string/support_pick_topic" />
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/finora_pill"
                android:drawablePadding="10dp"
                android:padding="12dp"
                android:text="@string/support_privacy"
                android:textColor="@color/finora_ink"
                app:drawableStartCompat="@drawable/finora_ic_shield"
                app:drawableTint="@color/finora_green" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/records_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/support_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="56dp"
            android:text="@string/support_send"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_mail"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
