<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/finora_outer_margin">

        <TextView
            android:id="@+id/goal_heading"
            style="@style/FinoraText.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/goal_list_title" />

        <Button
            android:id="@+id/records_add"
            style="@style/FinoraButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/records_add" />

        <TextView
            android:id="@+id/records_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/records_retry"
            style="@style/FinoraButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/finora_space_s"
            android:text="@string/records_retry" />

        <LinearLayout
            android:id="@+id/records_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
