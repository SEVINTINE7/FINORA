<?xml version="1.0" encoding="utf-8"?>
<!-- T64.2/D65 Savings goals: Simulate shortcut, saved-toward-goals summary, progress cards (focus goal first), Add goal FAB. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/goal_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="@dimen/finora_fab_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/goal_heading"
                    style="@style/FinoraText.Greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="@string/finora_heading_tag"
                    android:text="@string/goal_list_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/goal_simulate"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/goal_simulate"
                    android:textColor="@color/finora_ink"
                    app:backgroundTint="@color/finora_neutral_surface"
                    app:icon="@drawable/finora_ic_trend"
                    app:iconTint="@color/finora_ink" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/goal_summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/finora_hero"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/goal_summary_label"
                        android:textColor="@color/finora_hero_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/goal_summary_amount"
                        style="@style/FinoraText.Hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autoSizeMaxTextSize="32sp"
                        android:autoSizeMinTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/goal_summary_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        app:indicatorColor="@color/finora_mint"
                        app:trackColor="@color/finora_hero_tile"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/goal_summary_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/finora_hero_ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/records_status"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/records_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/records_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/records_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/records_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/goal_add_goal"
        app:icon="@drawable/finora_ic_add" />
</FrameLayout>
