<?xml version="1.0" encoding="utf-8"?>
<!-- T66.2/D65/D70 Insights: month switcher, score ring with Update score details, the five score parts, then one card
     per spending pattern (chart + the same facts in words), a link to that month's advice and the disclaimer. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insights_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/insights_title"
            style="@style/FinoraText.Greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="@string/finora_heading_tag"
            android:text="@string/insights_tab" />

        <include
            android:id="@+id/insights_switch"
            layout="@layout/view_month_switch" />

        <TextView
            android:id="@+id/insights_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/insights_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/insights_score_card"
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/insights_score_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:importantForAccessibility="noHideDescendants">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/insights_score_ring"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:indicatorColor="@color/finora_green"
                            app:indicatorSize="96dp"
                            app:trackColor="@color/finora_card_line"
                            app:trackCornerRadius="5dp"
                            app:trackThickness="9dp" />

                        <TextView
                            android:id="@+id/insights_score_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/finora_ink"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/insights_score_heading"
                            style="@style/FinoraText.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/score_heading"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/insights_score_text"
                            style="@style/FinoraText.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/finora_muted" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/insights_update"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/score_update"
                    app:icon="@drawable/finora_ic_edit"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/insights_parts_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/insights_parts_heading"
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/score_parts_heading"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/insights_parts_count"
                style="@style/FinoraText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/finora_muted" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/insights_parts_card"
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:id="@+id/insights_parts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/insights_patterns_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/insights_patterns_heading"
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/insight_patterns"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/insights_patterns_count"
                style="@style/FinoraText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/finora_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/insights_empty"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/insight_empty"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/insights_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/insights_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/finora_success_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_star"
                    app:tint="@color/finora_green" />
                <TextView
                    android:id="@+id/insights_advice_text"
                    style="@style/FinoraText.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/finora_green" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/finora_ic_chevron_right"
                    app:tint="@color/finora_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/score_disclaimer"
            android:textColor="@color/finora_muted" />
    </LinearLayout>
</ScrollView>
