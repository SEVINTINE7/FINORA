<?xml version="1.0" encoding="utf-8"?>
<!-- T67.2/D71 full-screen review sheet body: title, intro, optional "choices unavailable" note, one card per
     transaction and the selected count. Cancel and Save N are the dialog's own buttons. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/review_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/review_title"
            style="@style/FinoraText.Greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="@string/finora_heading_tag"
            android:text="@string/sms_transaction_preview" />

        <TextView
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sms_review_intro"
            android:textColor="@color/finora_muted" />

        <TextView
            android:id="@+id/review_unavailable"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sms_preview_choices_unavailable"
            android:textColor="@color/finora_error"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/review_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/review_count"
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/finora_muted" />
    </LinearLayout>
</ScrollView>
