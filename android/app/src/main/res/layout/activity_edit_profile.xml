<?xml version="1.0" encoding="utf-8"?>
<!-- T68.2/D72 Edit profile: name (PUT /me) and an email change confirmed by password and an emailed code (POST /me/email and /me/email/confirm are planned in T74). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/profile_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_edit_profile" />

            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/profile_name_input"
                android:text="@string/register_name" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/finora_ic_person"
                app:startIconTint="@color/finora_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/profile_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/profile_email_input"
                android:text="@string/profile_email" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/finora_ic_mail"
                app:startIconTint="@color/finora_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/profile_email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/profile_email_help"
                android:textColor="@color/finora_muted" />
            <LinearLayout
                android:id="@+id/profile_password_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/profile_password_input"
                    android:text="@string/password_current" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/finora_ic_lock"
                    app:startIconTint="@color/finora_muted">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@id/profile_password_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:minHeight="@dimen/finora_touch"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/profile_password_help"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profile_code_group"
                style="@style/Widget.Finora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/profile_code_help"
                        style="@style/FinoraText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:drawablePadding="10dp"
                        app:drawableStartCompat="@drawable/finora_ic_mail"
                        app:drawableTint="@color/finora_green" />
                    <TextView
                        style="@style/Finora.FormLabel"
                        android:labelFor="@+id/profile_code_input"
                        android:text="@string/profile_code" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/FinoraField.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/finora_ic_lock"
                        app:startIconTint="@color/finora_muted">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@id/profile_code_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:minHeight="@dimen/finora_touch"
                            android:saveEnabled="false"
                            android:maxLength="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_code_confirm"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="@dimen/finora_touch"
                        android:text="@string/profile_confirm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/records_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/profile_save"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_tick"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
