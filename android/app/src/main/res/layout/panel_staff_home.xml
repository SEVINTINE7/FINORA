<?xml version="1.0" encoding="utf-8"?>
<!-- T70.2/D72 Staff home: navy header with the queue counts, then a sheet with work rows, account rows and the
     rule 4 note. Language and Sign out trigger the shell's own controls (ProtectedHomeActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/staff_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_navy"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/staff_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="@dimen/finora_space_s"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="@dimen/finora_space_xl">

            <TextView
                style="@style/FinoraText.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/finora_space_xs"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:text="@string/app_name"
                app:drawableStartCompat="@drawable/finora_mark" />

            <TextView
                android:id="@+id/staff_title"
                style="@style/FinoraText.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_m"
                android:text="@string/staff_home_title"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/staff_subtitle"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/staff_home_today"
                android:textColor="@color/finora_on_navy_muted" />

            <LinearLayout
                android:id="@+id/staff_counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_m"
                android:baselineAligned="false"
                android:focusable="true"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/finora_staff_tile"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/staff_count_mine"
                        style="@style/FinoraText.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_count_none"
                        android:textColor="@color/finora_mint"
                        android:textSize="30sp" />
                    <TextView
                        style="@style/FinoraText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_count_mine"
                        android:textColor="@color/finora_on_navy" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/finora_staff_tile"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/staff_count_waiting"
                        style="@style/FinoraText.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_count_none"
                        android:textColor="@color/finora_mint"
                        android:textSize="30sp" />
                    <TextView
                        style="@style/FinoraText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_count_waiting"
                        android:textColor="@color/finora_on_navy" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/staff_counts_problem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/finora_space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/staff_counts_state"
                    style="@style/FinoraText.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/finora_on_navy" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/staff_counts_retry"
                    style="@style/Widget.Finora.TextAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/finora_touch"
                    android:text="@string/records_retry"
                    android:textColor="@color/finora_mint"
                    app:icon="@drawable/finora_ic_refresh"
                    app:iconTint="@color/finora_mint" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/staff_sheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/finora_sheet"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="@dimen/finora_space_m"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="@dimen/finora_space_xl">

            <TextView
                android:id="@+id/staff_work_heading"
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/staff_work" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        android:id="@+id/staff_requests"
                        layout="@layout/item_import_link" />
                    <View style="@style/Finora.RowLine" />
                    <include
                        android:id="@+id/staff_replies"
                        layout="@layout/item_import_link" />
                    <View style="@style/Finora.RowLine" />
                    <include
                        android:id="@+id/staff_diagnostics"
                        layout="@layout/item_import_link" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/staff_account_heading"
                style="@style/FinoraText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/more_account" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        android:id="@+id/staff_language"
                        layout="@layout/item_import_link" />
                    <View style="@style/Finora.RowLine" />
                    <include
                        android:id="@+id/staff_sign_out"
                        layout="@layout/item_import_link" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/staff_privacy"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/finora_pill"
                android:drawablePadding="10dp"
                android:padding="12dp"
                android:text="@string/staff_privacy_note"
                android:textColor="@color/finora_ink"
                app:drawableStartCompat="@drawable/finora_ic_shield"
                app:drawableTint="@color/finora_green" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
