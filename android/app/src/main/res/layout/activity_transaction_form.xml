<?xml version="1.0" encoding="utf-8"?>
<!-- T62.5/D65 Add/Edit transaction: type first, large amount, category chips with icons, Save pinned. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/form_title"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/form_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="noExcludeDescendants"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/form_type"
                    android:text="@string/transaction_type" />
                <lk.finora.app.ui.FormChoices
                    android:id="@id/form_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false" />
                <TextView
                    android:id="@+id/form_type_error"
                    style="@style/Finora.FormError" />

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/form_amount"
                    android:text="@string/transaction_amount" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:hintEnabled="false"
                    app:expandedHintEnabled="false"
                    app:placeholderText="@string/form_amount_placeholder"
                    app:prefixText="@string/form_rupees_prefix"
                    app:prefixTextAppearance="@style/Finora.AmountPrefix">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@id/form_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:minHeight="64dp"
                        android:saveEnabled="false"
                        android:textColor="@color/finora_ink"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/form_amount_error"
                    style="@style/Finora.FormError" />

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/form_category"
                    android:text="@string/transaction_category" />
                <lk.finora.app.ui.FormChoices
                    android:id="@id/form_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:saveEnabled="false" />
                <TextView
                    android:id="@+id/form_category_error"
                    style="@style/Finora.FormError" />

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/form_account"
                    android:text="@string/transaction_account" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/finora_row_single"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/finora_ic_wallet"
                        app:tint="@color/finora_muted" />
                    <Spinner
                        android:id="@id/form_account"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="56dp"
                        android:saveEnabled="false" />
                </LinearLayout>
                <TextView
                    android:id="@+id/form_account_error"
                    style="@style/Finora.FormError" />

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/form_date"
                    android:text="@string/form_date_label" />
                <com.google.android.material.button.MaterialButton
                    android:id="@id/form_date"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textColor="@color/finora_ink"
                    app:cornerRadius="@dimen/finora_group_radius"
                    app:icon="@drawable/finora_ic_calendar"
                    app:iconPadding="12dp"
                    app:iconTint="@color/finora_muted"
                    app:strokeColor="@color/finora_card_line" />
                <TextView
                    android:id="@+id/form_date_error"
                    style="@style/Finora.FormError" />

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/form_merchant"
                    android:text="@string/transaction_merchant" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@id/form_merchant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:minHeight="48dp"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/form_merchant_error"
                    style="@style/Finora.FormError" />

                <TextView
                    style="@style/Finora.FormLabel"
                    android:labelFor="@+id/form_note"
                    android:text="@string/transaction_note" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FinoraField.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@id/form_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minHeight="48dp"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/form_note_error"
                    style="@style/Finora.FormError" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/form_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/form_review"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/transaction_check_records"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/form_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/form_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/records_save"
            android:textSize="16sp"
            android:visibility="gone"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_tick"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
