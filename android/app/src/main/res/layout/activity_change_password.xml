<?xml version="1.0" encoding="utf-8"?>
<!-- T68.2/D72 Change password: current, new and repeated new password (POST /me/password is planned in T74). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/password_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_change_password" />

            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="10dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/password_signout_note"
                android:textColor="@color/finora_muted"
                app:drawableStartCompat="@drawable/finora_ic_shield"
                app:drawableTint="@color/finora_green" />
            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/password_current_input"
                android:text="@string/password_current" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/finora_ic_lock"
                app:startIconTint="@color/finora_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/password_current_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/password_new_input"
                android:text="@string/password_new" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/finora_ic_lock"
                app:startIconTint="@color/finora_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/password_new_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/register_password_rule"
                android:textColor="@color/finora_muted" />
            <TextView
                style="@style/Finora.FormLabel"
                android:labelFor="@+id/password_repeat_input"
                android:text="@string/password_repeat" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/FinoraField.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/finora_ic_lock"
                app:startIconTint="@color/finora_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/password_repeat_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:minHeight="@dimen/finora_touch"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/records_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/records_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/settings_change_password"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/finora_ic_lock"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
