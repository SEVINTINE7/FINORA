<?xml version="1.0" encoding="utf-8"?>
<!-- T67/D71 "other ways to add records" row: icon, title, one-line help, chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    tools:ignore="Overdraw">

    <ImageView
        android:id="@+id/link_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/finora_circle"
        android:backgroundTint="@color/finora_neutral_surface"
        android:importantForAccessibility="no"
        android:padding="10dp"
        app:tint="@color/finora_ink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/link_title"
            style="@style/FinoraText.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/link_text"
            style="@style/FinoraText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/finora_muted" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/finora_ic_chevron_right"
        app:tint="@color/finora_muted" />
</LinearLayout>
