<?xml version="1.0" encoding="utf-8"?>
<!-- T65.2/D65/D69 Accounts: intro, In use cards, Archived section (chip, no remove), Add account FAB. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/finora_screen_margin"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/finora_screen_margin"
            android:paddingBottom="@dimen/finora_fab_clearance">

            <TextView
                android:id="@+id/account_heading"
                style="@style/FinoraText.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="@string/finora_heading_tag"
                android:text="@string/account_list_title" />

            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/account_intro"
                android:textColor="@color/finora_muted" />

            <TextView
                android:id="@+id/records_status"
                style="@style/FinoraText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/records_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/records_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/account_in_use_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/account_in_use_heading"
                    style="@style/FinoraText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/account_in_use"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/account_in_use_count"
                    style="@style/FinoraText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/records_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/account_archived_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/account_archived_heading"
                    style="@style/FinoraText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/account_archived_heading"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/account_archived_count"
                    style="@style/FinoraText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/account_archived_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/account_archived_note"
                style="@style/FinoraText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/account_archived_note"
                android:textColor="@color/finora_muted"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/records_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/account_add"
        app:icon="@drawable/finora_ic_add" />
</FrameLayout>
