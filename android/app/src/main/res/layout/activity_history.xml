<?xml version="1.0" encoding="utf-8"?>
<!-- T66.3/D65/D70 Monthly history: 6/12/24-month toggle, period switcher, score trend chart with a summary in words,
     then month cards newest first. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/finora_screen_margin"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/finora_screen_margin"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/history_heading"
            style="@style/FinoraText.Greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="@string/finora_heading_tag"
            android:text="@string/history_title" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/history_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/history_range_6"
                style="@style/Widget.Finora.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/history_range_12"
                style="@style/Widget.Finora.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/history_range_24"
                style="@style/Widget.Finora.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <include
            android:id="@+id/history_switch"
            layout="@layout/view_month_switch" />

        <TextView
            android:id="@+id/history_status"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/records_retry"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/history_chart_card"
            style="@style/Widget.Finora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/history_chart_heading"
                    style="@style/FinoraText.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="@string/finora_heading_tag"
                    android:text="@string/history_chart" />
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/history_chart"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="8dp"
                    android:focusable="true" />
                <TextView
                    android:id="@+id/history_summary"
                    style="@style/FinoraText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/finora_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/history_months_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/history_months_heading"
                style="@style/FinoraText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/history_months"
                android:textSize="16sp" />
            <TextView
                style="@style/FinoraText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_newest"
                android:textColor="@color/finora_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/history_empty"
            style="@style/FinoraText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/history_empty"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
