<resources>
    <color name="finora_navy">#102529</color>
    <color name="finora_navy_line">#436D60</color>
    <color name="finora_mint">#C8F5CC</color>
    <color name="finora_on_navy">#FFFFFF</color>
    <color name="finora_surface">#F8FAF6</color>
    <color name="finora_field">#FFFFFF</color>
    <color name="finora_ink">#142B29</color>
    <color name="finora_muted">#4B6159</color>
    <color name="finora_outline">#7B8F83</color>
    <color name="finora_green">#155744</color>
    <color name="finora_pressed">#104536</color>
    <color name="finora_focus">#247755</color>
    <color name="finora_disabled">#DFE9E1</color>
    <color name="finora_disabled_ink">#42574D</color>
    <color name="finora_error">#982C30</color>
    <color name="finora_error_surface">#FCEDEA</color>
    <color name="finora_success_surface">#E1F2E5</color>
    <color name="finora_neutral_surface">#EAF0EB</color>

    <dimen name="finora_space_xs">6dp</dimen>
    <dimen name="finora_space_s">12dp</dimen>
    <dimen name="finora_space_m">16dp</dimen>
    <dimen name="finora_space_l">22dp</dimen>
    <dimen name="finora_space_xl">28dp</dimen>
    <dimen name="finora_outer_margin">24dp</dimen>
    <dimen name="finora_login_content_width">480dp</dimen>
    <dimen name="finora_touch">48dp</dimen>
    <dimen name="finora_control_height">56dp</dimen>
    <dimen name="finora_control_radius">14dp</dimen>
    <dimen name="finora_sheet_radius">30dp</dimen>
    <dimen name="finora_outline_width">1dp</dimen>
    <dimen name="finora_focus_width">2dp</dimen>
    <dimen name="finora_icon">20dp</dimen>
    <dimen name="finora_art_size">152dp</dimen>

    <style name="Theme.Finora" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/finora_green</item>
        <item name="android:windowBackground">@color/finora_navy</item>
        <item name="android:statusBarColor">@color/finora_navy</item>
        <item name="android:navigationBarColor">@color/finora_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="FinoraText">
        <item name="android:textColor">@color/finora_ink</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="FinoraText.Wordmark">
        <item name="android:textColor">@color/finora_on_navy</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="FinoraText.Display">
        <item name="android:textColor">@color/finora_on_navy</item>
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="FinoraText.Heading">
        <item name="android:textSize">25sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="FinoraText.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/finora_muted</item>
    </style>
    <style name="FinoraText.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/finora_muted</item>
    </style>
    <style name="FinoraText.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="FinoraText.FieldError" parent="FinoraText.Caption">
        <item name="android:paddingTop">@dimen/finora_space_xs</item>
        <item name="android:textColor">@color/finora_error</item>
    </style>
    <style name="FinoraInput">
        <item name="android:background">@null</item>
        <item name="android:minHeight">@dimen/finora_control_height</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/finora_ink</item>
        <item name="android:textColorHint">@color/finora_muted</item>
        <item name="android:paddingStart">@dimen/finora_space_s</item>
        <item name="android:paddingEnd">@dimen/finora_space_s</item>
    </style>
    <style name="FinoraButton">
        <item name="android:minHeight">@dimen/finora_control_height</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">@dimen/finora_space_l</item>
        <item name="android:paddingEnd">@dimen/finora_space_l</item>
        <item name="android:paddingTop">@dimen/finora_space_s</item>
        <item name="android:paddingBottom">@dimen/finora_space_s</item>
    </style>
    <style name="FinoraButton.Primary">
        <item name="android:background">@drawable/finora_button_primary</item>
        <item name="android:textColor">@color/finora_primary_text</item>
    </style>
    <style name="FinoraButton.Secondary">
        <item name="android:background">@drawable/finora_button_secondary</item>
        <item name="android:textColor">@color/finora_secondary_text</item>
    </style>
</resources>
