<?xml version="1.0" encoding="utf-8"?>
<!-- T62/D65 screen redesign kit. Colours reuse the FINORA roles; the hero card keeps navy and mint in both themes. -->
<resources>
    <color name="finora_card_line">#DCE5DF</color>
    <color name="finora_hero">@color/finora_navy</color>
    <color name="finora_hero_tile">#24393C</color>
    <color name="finora_hero_ink">#FFFFFF</color>
    <color name="finora_hero_muted">@color/finora_mint</color>
    <color name="finora_nav_surface">#FFFFFF</color>
    <color name="finora_chart_2">#2E6F8E</color>
    <color name="finora_chart_3">#B7791F</color>
    <color name="finora_chart_4">#6FBF96</color>
    <color name="finora_chart_5">#8A9A93</color>
    <color name="finora_chart_6">#7A5BA8</color>

    <dimen name="finora_group_radius">18dp</dimen>
    <dimen name="finora_screen_margin">20dp</dimen>
    <dimen name="finora_row_icon">40dp</dimen>
    <dimen name="finora_fab_clearance">104dp</dimen>

    <style name="FinoraText.Greeting">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/finora_ink</item>
    </style>
    <style name="FinoraText.Section">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/finora_ink</item>
    </style>
    <style name="FinoraText.RowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/finora_ink</item>
    </style>
    <style name="FinoraText.Hero">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/finora_hero_ink</item>
    </style>

    <style name="Widget.Finora.TextAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/finora_green</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="Widget.Finora.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/finora_segment_fill</item>
        <item name="android:textColor">@color/finora_segment_ink</item>
        <item name="iconTint">@color/finora_segment_ink</item>
        <item name="strokeColor">@color/finora_outline</item>
    </style>
    <style name="Widget.Finora.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/finora_chip_fill</item>
        <item name="android:textColor">@color/finora_chip_ink</item>
        <item name="chipStrokeColor">@color/finora_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIcon">@drawable/finora_ic_chevron_down</item>
        <item name="closeIconTint">@color/finora_chip_ink</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <string name="finora_heading_tag" translatable="false">heading</string>

    <style name="Widget.Finora.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/finora_field</item>
        <item name="strokeColor">@color/finora_card_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Finora.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Finora.FormLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">@style/FinoraText.Caption</item>
        <item name="android:textColor">@color/finora_muted</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Finora.FormError" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:textColor">?attr/colorError</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="Finora.AmountPrefix" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/finora_muted</item>
        <item name="android:textStyle">bold</item>
    </style>
    <color name="finora_chart_7">#B5476B</color>
    <color name="finora_chart_8">#5865B8</color>
    <color name="finora_warn_fill">#FDF0D5</color>
    <color name="finora_warn_ink">#7A4B00</color>
    <color name="finora_bar_over">#982C30</color>
    <!-- T68: hairline between rows in a grouped card, starting after the 40dp row icon. -->
    <style name="Finora.RowLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">68dp</item>
        <item name="android:background">@color/finora_card_line</item>
    </style>
    <!-- T68.3: status chip (icon + word, never colour alone). Colours and icon are set in code. -->
    <style name="Finora.StatusChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:background">@drawable/finora_pill</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
