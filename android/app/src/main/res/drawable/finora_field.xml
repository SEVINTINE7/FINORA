<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/finora_field" />
            <corners android:radius="@dimen/finora_control_radius" />
            <stroke android:width="@dimen/finora_focus_width" android:color="@color/finora_error" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/finora_field" />
            <corners android:radius="@dimen/finora_control_radius" />
            <stroke android:width="@dimen/finora_focus_width" android:color="@color/finora_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/finora_field" />
            <corners android:radius="@dimen/finora_control_radius" />
            <stroke android:width="@dimen/finora_outline_width" android:color="@color/finora_outline" />
        </shape>
    </item>
</selector>
