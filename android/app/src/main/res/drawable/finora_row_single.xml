<?xml version="1.0" encoding="utf-8"?>
<!-- T62: one segment of a grouped list card. A hidden bottom edge lets the next row's top edge act as the divider. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/finora_field" />
            <stroke android:width="1dp" android:color="@color/finora_card_line" />
            <corners android:topLeftRadius="@dimen/finora_group_radius" android:topRightRadius="@dimen/finora_group_radius" android:bottomLeftRadius="@dimen/finora_group_radius" android:bottomRightRadius="@dimen/finora_group_radius" />
        </shape>
    </item>
</layer-list>
