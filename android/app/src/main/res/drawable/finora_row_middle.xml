<?xml version="1.0" encoding="utf-8"?>
<!-- T62: one segment of a grouped list card. A hidden bottom edge lets the next row's top edge act as the divider. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/finora_field" />
            <stroke android:width="1dp" android:color="@color/finora_card_line" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
