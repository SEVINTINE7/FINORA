<?xml version="1.0" encoding="utf-8"?>
<!-- T68.3 topic tile on New support request: the chosen one gets a green 2dp outline and tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/finora_success_surface" />
            <stroke android:width="2dp" android:color="@color/finora_green" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/finora_field" />
            <stroke android:width="1dp" android:color="@color/finora_card_line" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
