            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
        <activity android:name=".ui.login.LoginActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.main.MainActivity" android:exported="false" />
        <activity android:name=".ui.insights.InsightsActivity" android:exported="false" />
        <activity android:name=".ui.history.HistoryActivity" android:exported="false" />
        <activity android:name=".ui.advice.AdviceActivity" android:exported="false" />
        <activity android:name=".ui.register.RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminHomeActivity" android:exported="false" />
        <activity android:name=".ui.staff.StaffHomeActivity" android:exported="false" />
        <activity android:name=".ui.sms.SmsAccessActivity" android:exported="false" />
        <activity android:name=".ui.sms.PasteSmsActivity" android:exported="false" />
        <activity android:name=".ui.importer.CsvImportActivity" android:exported="false" />
        <activity android:name=".ui.accounts.AccountListActivity" android:exported="false" />
        <activity android:name=".ui.accounts.AccountFormActivity" android:exported="false" />
        <activity android:name=".ui.categories.CategoryListActivity" android:exported="false" />
        <activity android:name=".ui.categories.CategoryFormActivity" android:exported="false" />
        <activity android:name=".ui.transactions.TransactionActivity" android:exported="false" />
        <activity android:name=".ui.transactions.TransactionFormActivity" android:exported="false"
